#!/usr/bin/env php
<?php

require_once __DIR__ . '/../../../autoload.php';

use Symfony\Component\Console\Application;
use Symfony\Component\DependencyInjection\ContainerBuilder;
use Symfony\Component\DependencyInjection\Loader\YamlFileLoader;
use Symfony\Component\Config\FileLocator;

$container = new ContainerBuilder();
$fileLocator = new FileLocator(__DIR__ . '/../config/');
$loader = new YamlFileLoader($container, $fileLocator);
$loader->load('services.yml');
$container->compile();

$app = new Application();

// Dynamically add all commands
$commandsDir = __DIR__ . '/../src/Commands';
$commandFiles = scandir($commandsDir);
foreach ($commandFiles as $commandFile) {
    if (!str_ends_with($commandFile, 'Command.php')) {
        continue;
    }
    $class = 'emteknetnz\\JsUpdater\\Commands\\' . str_replace('.php', '', $commandFile);
    $app->add(new $class($container));
}

$app->run();
