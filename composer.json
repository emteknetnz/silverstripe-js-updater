{
    "name": "emteknetnz/silverstripe-js-updater",
    "type": "silverstripe-vendormodule",
    "description": "JS Updater for Silverstripe CMS",
    "license": "MIT",
    "require": {
        "knplabs/github-api": "^3",
        "guzzlehttp/guzzle": "^7",
        "silverstripe/supported-modules": "^1 || ^2",
        "symfony/console": "^6 || ^7",
        "symfony/process": "^6 || ^7",
        "symfony/dotenv": "^6 || ^7"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3"
    },
    "autoload": {
        "psr-4": {
            "emteknetnz\\JsUpdater\\": "src/"
        }
    },
    "bin": [
        "bin/update-js"
    ],
    "scripts": {
        "update-js": "bin/update-js",
        "lint": "phpcs"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
