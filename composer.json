{
    "name": "emteknetnz/silverstripe-js-updater",
    "type": "silverstripe-vendormodule",
    "description": "JS Updater for Silverstripe CMS",
    "keywords": [
        "silverstripe",
        "javascript"
    ],
    "license": "MIT",
    "require": {
        "silverstripe/supported-modules": "*",
        "symfony/console": "*",
        "symfony/process": "*",
        "knplabs/github-api": "*",
        "symfony/http-client": "*",
        "nyholm/psr7": "*"
    },
    "autoload": {
        "psr-4": {
            "emteknetnz\\JsUpdater\\": "src/"
        }
    },
    "bin": [
        "bin/update-js"
    ],
    "scripts": {
        "update-js": "bin/update-js"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
